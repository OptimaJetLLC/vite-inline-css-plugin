{
  "name": "vite-inline-css-plugin",
  "description": "Vite plugin that inlines CSS imports as base64 data URLs",
  "version": "0.0.1",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "author": "Optimajet",
  "keywords": [
    "vite",
    "css",
    "base64",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OptimaJetLLC/vite-inline-css-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/OptimaJetLLC/vite-inline-css-plugin/issues"
  },
  "homepage": "https://github.com/OptimaJetLLC/vite-inline-css-plugin#readme",
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "generate-dts": "tsc --project tsconfig.build.json",
    "build": "rollup -c rollup.config.js && npm run generate-dts",
    "pack:test": "tsx scripts/pack-test",
    "test:integration": "tsx --test tests/*.test.ts",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "test": "npm run prettier:check && npm run typecheck && npm run lint && npm run build && npm run test:integration && npm run pack:test",
    "release": "npm test && tsx scripts/release",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/fs-extra": "^11",
    "@types/node": "^24.19.2",
    "@types/signale": "^1",
    "@types/yargs": "^17.0.35",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fs-extra": "^11.4.1",
    "knip": "^6.44.1",
    "new-github-release-url": "^2.0.0",
    "open": "^11.0.4",
    "prettier": "^3.9.10",
    "rollup": "^4.67.2",
    "rollup-plugin-esbuild": "^6.2.1",
    "signale": "^1.4.0",
    "simple-git": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "version-next": "^1.0.2",
    "vite": "^8.3.5",
    "yargs": "^18.2.0",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "vite": "^7.2.7 || ^8.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
